# ==============================================================================
# ArogyaGPT Backend - Environment Variables Reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==============================================================================

# --- Application ---
APP_NAME=ArogyaGPT
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true
ALLOWED_HOSTS=["*"]

# --- CORS (comma-separated list of allowed origins) ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://arogyagpt:arogyagpt_secret@localhost:5432/arogyagpt
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
REDIS_TOKEN_BLACKLIST_DB=1
REDIS_CACHE_DB=2
REDIS_CELERY_DB=3

# --- JWT Authentication ---
# IMPORTANT: Generate a strong key: python -c "import secrets; print(secrets.token_hex(64))"
SECRET_KEY=CHANGE-THIS-TO-A-VERY-LONG-RANDOM-SECRET-KEY-AT-LEAST-64-CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/3

# --- AI / Groq LLM ---
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=llama3-70b-8192
GROQ_MAX_TOKENS=4096
GROQ_TEMPERATURE=0.1

# --- OpenAI (Optional fallback) ---
OPENAI_API_KEY=your_openai_api_key_here

# --- Embeddings ---
HUGGINGFACE_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- FAISS Vector Store ---
FAISS_INDEX_PATH=./data/faiss_index
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
RAG_TOP_K=5

# --- NLP ---
SPACY_MODEL=en_core_web_sm

# --- OCR ---
# On Windows, set the full path to tesseract.exe
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=tesseract
OCR_PROVIDER=tesseract
OCR_LANGUAGE=eng
MAX_UPLOAD_SIZE_MB=20

# --- File Upload ---
UPLOAD_DIR=./data/uploads
ALLOWED_FILE_TYPES=["pdf","png","jpg","jpeg"]

# --- AWS S3 (Optional — uses local storage if USE_S3=false) ---
USE_S3=false
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET=arogyagpt-uploads

# --- Translation ---
USE_GOOGLE_TRANSLATE=false
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key

# --- Text-to-Speech ---
TTS_PROVIDER=gtts
TTS_OUTPUT_DIR=./data/audio
# For Azure TTS (higher quality):
AZURE_TTS_KEY=your_azure_tts_key
AZURE_TTS_REGION=eastus

# --- Email (SMTP) ---
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@arogyagpt.com
SMTP_TLS=true

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=./logs/arogyagpt.log
LOG_ROTATION=10 MB
LOG_RETENTION=30 days
LOG_JSON_FORMAT=false

# --- Admin Seed ---
FIRST_ADMIN_EMAIL=admin@arogyagpt.com
FIRST_ADMIN_PASSWORD=Admin@12345!
