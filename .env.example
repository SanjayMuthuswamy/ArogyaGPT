# Copy to .env for Docker Compose deployment. Use unique, randomly generated
# values and configure the public hostnames used by your HTTPS reverse proxy.
POSTGRES_USER=arogyagpt
POSTGRES_PASSWORD=replace-with-a-long-random-alphanumeric-password
POSTGRES_DB=arogyagpt
DATABASE_URL=postgresql+asyncpg://arogyagpt:replace-with-a-long-random-alphanumeric-password@postgres:5432/arogyagpt
SECRET_KEY=replace-with-a-unique-random-secret-at-least-64-characters-long
ALLOWED_HOSTS=["your-domain.example","www.your-domain.example"]
CORS_ORIGINS=["https://your-domain.example","https://www.your-domain.example"]
